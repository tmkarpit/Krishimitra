# Copy to supabase/functions/.env for local `supabase functions serve`,
# or set in production with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically.)

# Required — FREE Google Gemini key for AI advice, chat, disease photos, soil cards and voice input.
# Get it at https://aistudio.google.com/apikey (Google account only, no card).
GEMINI_API_KEY=
# Optional model overrides (both on the free tier)
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Optional, paid — switch the AI to Anthropic Claude instead of Gemini
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-5-5

# Optional — better Indian-language voice (STT + TTS) via Sarvam AI (https://dashboard.sarvam.ai)
SARVAM_API_KEY=

# Optional, free — live mandi prices from Agmarknet (https://data.gov.in -> My Account -> API key)
DATA_GOV_IN_API_KEY=

# Optional — XGBoost crop model (ml-service/). Without it, rule-based scoring is used.
ML_SERVICE_URL=
ML_SERVICE_TOKEN=

# Required for the weather-alerts cron job (any long random string)
CRON_SECRET=
